---
import RuleBand from "./RuleBand.astro";
import RegMarks from "./RegMarks.astro";
import SectionHead from "./SectionHead.astro";
import { roles } from "../data/experience";
---

<section class="section" id="experience">
  <RegMarks corners={["tl", "br"]} />

  <RuleBand rules="right">
    <SectionHead num="02" title="Experience." />
  </RuleBand>

  {/* Right rule only. The left interior rule at 25% falls at x=360, while the
      timeline's text starts at 128px — clearing it by 24px would leave ~26
      characters of 13px mono, and the 26px job titles need far more than that.
      The timeline already draws its own vertical dimension line; a second
      competing vertical 360px in was noisy even when it fit. plan.md §10.4 */}
  <RuleBand rules="right">
    <div class="exp">
      <div class="exp__timeline">
        <div class="tl">
          <div class="tl__spine" aria-hidden="true"></div>
          {roles.map((r) => (
            <div class="tl__item">
              <div class="tl__head">
                <div class="tl__tick" aria-hidden="true"></div>
                <div class="tl__date">{r.date}</div>
                <div class="tl__title">{r.title}</div>
              </div>
              <div class="tl__org">{r.org}</div>
              <p class="tl__body">{r.body}</p>
            </div>
          ))}
          <div class="tl__end" aria-hidden="true">▼</div>
        </div>
      </div>

      <div class="exp__resume">
        <div class="exp__lbl">RESUME</div>
        {/* Opaque paper-2 fill: the rule passes behind it and reappears in the
            gutters either side. plan.md §10.8 */}
        <div class="resume raised">
          <div class="resume__state">NO DOCUMENT LOADED</div>
          <p class="resume__note">
            The inline viewer renders resume.pdf here at full width, scrollable,
            hairline-framed. Drop the file in and it fills.
          </p>
        </div>
        {/* Meta stacked under the button, not inline beside it — a rule cut
            through it in the prototype. No middle-dot separator. §10.9 */}
        <div class="resume__actions">
          <a class="btn-outline" href="#">DOWNLOAD RESUME</a>
          <span class="resume__meta">PDF — pending file</span>
        </div>
      </div>
    </div>
  </RuleBand>
</section>

<style>
  .exp {
    display: grid;
    grid-template-columns: 1fr 1fr;
    border-top: var(--hairline) solid var(--rule);
  }
  .exp__timeline { padding: 44px var(--pad-x) 56px; border-right: var(--hairline) solid var(--rule); }
  .exp__resume { padding: 44px var(--pad-x) 56px; display: flex; flex-direction: column; gap: 18px; }
  .exp__lbl { font-size: var(--fs-meta); color: var(--graphite); letter-spacing: var(--ls-label); }

  /* One source for the spine's x. The arrow below has to centre on it, and
     when the two were written as separate literals (88px and 85px) the glyph
     sat ~2px right of the line. */
  .tl { position: relative; padding-left: 96px; --spine: 88px; }
  .tl__spine { position: absolute; left: var(--spine); top: 6px; bottom: 6px; width: var(--hairline); background: var(--ink); }
  .tl__item { position: relative; padding-bottom: 52px; }
  .tl__item:last-of-type { padding-bottom: 8px; }
  .tl__head { position: relative; }
  .tl__tick { position: absolute; left: -16px; top: 50%; transform: translateY(-50%); width: 17px; height: var(--hairline); background: var(--ink); }
  .tl__date { position: absolute; left: -96px; top: 50%; transform: translateY(-50%); width: 72px; text-align: right; font-size: var(--fs-meta); color: var(--graphite); line-height: 1; }
  .tl__title { margin-left: 16px; font-family: var(--font-display); font-weight: 600; font-size: 26px; letter-spacing: var(--ls-display); line-height: 1; }
  /* Aligned to the title's 16px, not the old 28px — the body card below sits
     on that edge, and an org line indented further than the card under it read
     as a mistake. */
  .tl__org { margin-top: 9px; margin-left: 16px; font-size: var(--fs-prose); color: var(--graphite); }
  /* The gap above the card (24px) matches its gap to the spine: the card's
     edge lands at 112px and the spine centre at 88.5px. Square corners, so no
     radius is set anywhere — the sheet has none. */
  .tl__body {
    margin: 24px 0 0 16px;
    max-width: 50ch;
    padding: 12px 14px;
    background: var(--paper-2);
    border: var(--hairline) solid var(--rule);
    font-size: var(--fs-prose);
    color: var(--graphite);
  }
  /* Left edge on the spine's centre line, then pulled back by half the glyph's
     own width — so it stays centred whatever the character or font size. */
  .tl__end {
    position: absolute;
    left: calc(var(--spine) + var(--hairline) / 2);
    bottom: -4px;
    transform: translateX(-50%);
    font-size: var(--fs-label);
    line-height: 1;
  }

  .resume {
    border: var(--hairline) solid var(--rule);
    background: var(--paper-2);
    height: 420px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 14px;
    text-align: center;
    padding: 32px;
    background-image: repeating-linear-gradient(135deg, transparent 0 9px, rgba(196,191,178,.35) 9px 10px);
  }
  .resume__state { font-size: 12px; letter-spacing: var(--ls-label); color: var(--graphite); }
  .resume__note { margin: 0; max-width: 44ch; font-size: var(--fs-prose); color: var(--graphite); }

  .resume__actions { display: flex; flex-direction: column; align-items: flex-start; gap: 10px; }
  .resume__meta { font-size: var(--fs-meta); color: var(--graphite); }

  .btn-outline {
    border: var(--hairline) solid var(--vermilion);
    color: var(--vermilion);
    padding: 11px 20px;
    font-size: 12px;
    letter-spacing: 0.02em;
  }
  .btn-outline:hover { background: var(--vermilion); color: var(--paper-2); }

  @media (max-width: 900px) {
    .exp { grid-template-columns: 1fr; }
    .exp__timeline { border-right: 0; border-bottom: var(--hairline) solid var(--rule); }
  }
  @media (max-width: 560px) {
    /* Dates move above the title; the 96px gutter collapses. plan.md §11.1 */
    .tl { padding-left: 0; }
    .tl__spine, .tl__tick, .tl__end { display: none; }
    /* No spine to align to at this width, so the inset goes with it. */
    .tl__title, .tl__org, .tl__body { margin-left: 0; }
    .tl__date { position: static; width: auto; text-align: left; margin-bottom: 8px; }
  }
</style>
