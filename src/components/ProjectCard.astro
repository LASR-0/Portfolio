---
import type { CollectionEntry } from "astro:content";

interface Props { project: CollectionEntry<"projects">; }
const { project } = Astro.props;
const p = project.data;

/* Category tags are solid-filled with paper-2 text, the same treatment as the
   primary button. See the contrast note in tokens.css. */
const KIND_CLASS = {
  "Desktop App": "card__kind--desktop",
  "Internal tools": "card__kind--internal",
  "Mobile App": "card__kind--mobile",
} as const;

/* The licence cell is always LICENCE, so the badge carries what the old
   "Open source" category used to say — moved here because kind now describes
   what the thing is, not how it is licensed. */
const LICENCE_LABEL = { open: "OPEN SOURCE", private: "PRIVATE" } as const;
---

<article class="card">
  <div class="card__head">
    <span class:list={["card__kind", KIND_CLASS[p.kind]]}>{p.kind}</span>
    <span class="card__statuswrap">
      <span class:list={["card__lic", `card__lic--${p.licenceType}`]}>
        {LICENCE_LABEL[p.licenceType]}
      </span>
      <span class:list={["card__status", p.dot && "card__status--on"]}>
        {p.dot && <span class:list={["card__dot", `card__dot--${p.dot}`]} aria-hidden="true"></span>}
        {p.status}
      </span>
      {p.note && <span class="card__note">{p.note}</span>}
    </span>
  </div>

  <div class="card__body">
    <h3 class="card__title">{p.name}</h3>
    <p class="card__blurb">{p.blurb}</p>
  </div>

  <div class="card__cells">
    <div class="card__cell"><span class="lbl">STACK</span><span class="val">{p.stack}</span></div>
    <div class="card__cell"><span class="lbl">ROLE</span><span class="val">{p.role}</span></div>
  </div>

  <div class="card__cells card__cells--foot">
    <div class="card__cell"><span class="lbl">YEAR</span><span class="val">{p.year}</span></div>
    <div class="card__cell"><span class="lbl">LICENCE</span><span class="val">{p.licence}</span></div>
    <a class="card__open" href={`/work/${project.id}`} aria-label={`Open case study for ${p.name}`}>→</a>
  </div>
</article>

<style>
  .card {
    border-right: var(--hairline) solid var(--rule);
    border-bottom: var(--hairline) solid var(--rule);
    background: var(--paper-2);
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .card__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    padding: 12px 16px;
    /* Reserves the two-line height whether or not this card has a note.
       Without it, a card carrying one throws the head hairline out of
       alignment with its neighbours. Same reasoning as .val below. Raised from
       52px when the licence badge joined the stack above the status. */
    min-height: 64px;
    border-bottom: var(--hairline) solid var(--rule);
  }
  .card__kind {
    padding: 3px 8px;
    font-size: var(--fs-label);
    letter-spacing: var(--ls-label);
    color: var(--paper-2);
    white-space: nowrap;
  }
  .card__kind--desktop  { background: var(--tag-desktop); }
  .card__kind--internal { background: var(--tag-internal); }
  .card__kind--mobile   { background: var(--tag-mobile); }

  /* Outlined, not filled — the solid category tag sits opposite it and two
     solid blocks in one head row fight each other. */
  .card__lic {
    padding: 2px 6px;
    border: var(--hairline) solid currentColor;
    font-size: 9px;
    letter-spacing: var(--ls-label);
    line-height: 1.3;
    white-space: nowrap;
  }
  .card__lic--open    { color: var(--lic-open); }
  .card__lic--private { color: var(--lic-private); }
  /* Status stacks over its note so the head row stays one line tall when
     there is no note. */
  .card__statuswrap {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 3px;
    min-width: 0;
  }
  .card__status {
    display: flex;
    align-items: center;
    gap: 7px;
    font-size: var(--fs-label);
    line-height: 1.2;
    color: var(--graphite);
    white-space: nowrap;
  }
  .card__status--on { color: var(--ink); }
  .card__dot { width: 6px; height: 6px; display: block; }
  .card__dot--production { background: var(--status-live); }
  .card__dot--active     { background: var(--status-active); }
  /* Deliberately softened — reads as secondary to the status above it. */
  .card__note {
    font-size: 9px;
    line-height: 1.2;
    letter-spacing: var(--ls-label);
    color: var(--graphite);
    opacity: 0.7;
    white-space: nowrap;
  }

  .card__body { padding: 26px 16px 44px; min-height: 150px; }
  .card__title {
    font-weight: 600;
    font-size: var(--fs-card);
    line-height: var(--lh-card);
    /* 34px display type in a ~360px column: break rather than overflow. */
    overflow-wrap: anywhere;
  }
  .card__blurb {
    margin: 14px 0 0;
    font-size: var(--fs-prose);
    color: var(--graphite);
    text-wrap: pretty;
  }

  .card__cells {
    margin-top: auto;
    display: grid;
    grid-template-columns: 1fr 1fr;
    border-top: var(--hairline) solid var(--rule);
  }
  .card__cells--foot { margin-top: 0; grid-template-columns: 1fr 1fr 62px; }
  .card__cell {
    padding: 11px 16px;
    border-right: var(--hairline) solid var(--rule);
    min-width: 0;
  }
  .card__cells--foot .card__cell:nth-child(2) { border-right: var(--hairline) solid var(--rule); }
  .card__cell:last-child { border-right: 0; }

  .lbl {
    display: block;
    font-size: var(--fs-label);
    color: var(--graphite);
    letter-spacing: var(--ls-label);
  }
  /* At 4 columns these cells are ~148px, so longer stack strings wrap. The
     value reserves two lines whether it needs them or not, otherwise the
     horizontal hairlines stop aligning across the row — which on a drafting
     sheet reads as broken. plan.md §10.1 */
  .val {
    display: block;
    font-size: 14px;
    margin-top: 5px;
    line-height: 1.25;
    min-height: 2.5em;
    overflow-wrap: anywhere;
  }

  .card__open {
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 16px;
    border-left: var(--hairline) solid var(--rule);
  }
  .card__open:hover { background: var(--ink); color: var(--paper-2); }
</style>
