---
import RuleBand from "./RuleBand.astro";
import RegMarks from "./RegMarks.astro";
import SectionHead from "./SectionHead.astro";
import EnquiryForm from "./EnquiryForm.tsx";
---

<section class="section" id="start">
  <RegMarks corners={["tl", "tr"]} />

  {/* Title band keeps the right interior rule and is constrained to the form's
      measure so the two line up vertically. plan.md §10.7, amended. */}
  <RuleBand rules="right">
    <SectionHead title="Start a project." constrained>
      <div class="form-rev">FORM 01 / REV A</div>
    </SectionHead>
  </RuleBand>

  {/* The form band KEEPS its rules; the form is raised above them instead. */}
  <RuleBand>
    <div class="sp">
      <EnquiryForm client:visible />
    </div>
  </RuleBand>
</section>

<style>
  .form-rev { font-size: var(--fs-meta); color: var(--graphite); margin-bottom: 12px; }
  .sp { border-top: var(--hairline) solid var(--rule); padding: 36px var(--pad-x) 64px; }
</style>
