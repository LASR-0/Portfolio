---
import RegMarks from "./RegMarks.astro";
import HeroField from "./HeroField.tsx";

/* client:load rather than client:visible — the hero is above the fold and the
   field is part of the load sequence, so deferring it would show an empty
   panel first. It is the only island on the page that loads eagerly. */
---

<section class="hero">
  <RegMarks corners={["tl", "tr", "bl", "br"]} />
  <HeroField client:load />
  <div class="hero__lockup">
    <h1 class="hero__name">Luke Roxburgh</h1>
    <p class="hero__line"><span class="hero__line-in">Placeholder mono line for now.</span></p>
  </div>
</section>

<style>
  .hero {
    position: relative;
    /* Half-viewport band, not full. dvh rather than vh — mobile measures vh
       against the collapsed address bar and the hero gets clipped. §11.1 */
    height: calc(50dvh - var(--header-h) / 2);
    min-height: 340px;
    border-bottom: var(--hairline) solid var(--rule);
    overflow: hidden;
  }

  .hero__lockup {
    position: absolute;
    left: var(--pad-x);
    right: var(--pad-x);
    bottom: 32px;
    z-index: var(--z-raised);
    pointer-events: none;
  }

  .hero__name {
    font-weight: 700;
    font-size: var(--fs-hero);
    animation: riseIn var(--dur-rise) 0.5s var(--ease) both;
  }

  .hero__line {
    margin: 14px 0 0;
    max-width: var(--measure);
    color: var(--graphite);
    animation: riseIn var(--dur-rise) 0.68s var(--ease) both;
  }
  /* Boxed so the line stays legible over the field and the colour beneath it. */
  .hero__line-in {
    display: inline-block;
    background: var(--paper-2);
    border: var(--hairline) solid var(--rule);
    padding: 5px;
  }

</style>
