---
import RegMarks from "./RegMarks.astro";
import HeroField from "./HeroField.tsx";

/* client:load rather than client:visible — the hero is above the fold and the
   field is part of the load sequence, so deferring it would show an empty
   panel first. It is the only island on the page that loads eagerly. */
---

<section class="hero">
  <RegMarks corners={["tl", "tr", "bl", "br"]} />
  <HeroField client:load />
  <div class="hero__lockup">
    <h1 class="hero__name">Luke Roxburgh</h1>
    <p class="hero__line">Placeholder mono line for now.</p>
  </div>
</section>

<style>
  .hero {
    position: relative;
    /* dvh, not vh — mobile measures vh against the collapsed address bar and
       the hero gets clipped. plan.md §11.1 */
    height: calc(100dvh - var(--header-h));
    min-height: 620px;
    border-bottom: var(--hairline) solid var(--rule);
    overflow: hidden;
  }

  .hero__lockup {
    position: absolute;
    left: var(--pad-x);
    right: var(--pad-x);
    bottom: 64px;
    z-index: var(--z-raised);
    pointer-events: none;
  }

  .hero__name {
    font-weight: 700;
    font-size: var(--fs-hero);
    animation: riseIn var(--dur-rise) 0.5s var(--ease) both;
  }

  .hero__line {
    margin: 22px 0 0;
    max-width: var(--measure);
    color: var(--graphite);
    animation: riseIn var(--dur-rise) 0.68s var(--ease) both;
  }
</style>
