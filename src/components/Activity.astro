---
import RuleBand from "./RuleBand.astro";
import RegMarks from "./RegMarks.astro";
import SectionHead from "./SectionHead.astro";
import { seededLevels, MONTHS } from "../data/activity";

const levels = seededLevels();
const total = levels.reduce((a, b) => a + b * 3 + (b ? 1 : 0), 0);
---

<section class="section" id="activity">
  <RegMarks corners={["tl", "tr"]} />

  <RuleBand rules="none">
    <SectionHead num="03" title="Activity.">
      <div class="meta-cells">
        <div class="meta-cells__cell">
          <span class="lbl">SOURCE</span><span class="val">github.com/LASR-0</span>
        </div>
        <div class="meta-cells__cell">
          <span class="lbl">WINDOW</span><span class="val">52 weeks</span>
        </div>
      </div>
    </SectionHead>
  </RuleBand>

  {/* Right rule only. The grid runs from roughly x=72 to x=901, so the left
      interior rule at 25% (x=360) falls inside it; the right at 75% (x=1080)
      is clear. plan.md §10.5 */}
  <RuleBand rules="right">
    <div class="act">
      <div class="act__live">
          <div class="act__chart">
            <div class="act__days" aria-hidden="true">
              <span></span><span>MON</span><span></span><span>WED</span>
              <span></span><span>FRI</span><span></span>
            </div>
            {/* One role="img" with a summary, not 364 divs carrying title
                attributes — title is not an accessible name and the grid was
                invisible to screen readers. plan.md §11.5 */}
            <div class="act__scroll">
              <div
                class="act__grid"
                role="img"
                aria-label={`Contribution heatmap: ${total} contributions over the last 52 weeks.`}
              >
                {levels.map((lvl) => (
                  <div class="cell" data-lvl={lvl} aria-hidden="true"></div>
                ))}
              </div>
              <div class="act__months" aria-hidden="true">
                {MONTHS.map((m) => <span>{m}</span>)}
              </div>
            </div>
          </div>

          <div class="act__foot">
            <div class="act__count">{total} CONTRIBUTIONS — SEEDED DATA, PENDING TOKEN</div>
            <div class="act__legend" aria-hidden="true">
              <span>LESS</span>
              <span class="cell" data-lvl="0"></span>
              <span class="cell" data-lvl="1"></span>
              <span class="cell" data-lvl="2"></span>
              <span class="cell" data-lvl="3"></span>
              <span class="cell" data-lvl="4"></span>
              <span>MORE</span>
            </div>
          </div>
      </div>

      <div class="act__nosignal raised" hidden>
          <div class="act__state">NO SIGNAL</div>
          <p class="act__note">
            The contribution API did not answer. The commits still happened.
            Try github.com/LASR-0 directly.
          </p>
      </div>
    </div>
  </RuleBand>
</section>

<script>
  const root = document.querySelector<HTMLElement>("#activity");
  if (root) {
    const live = root.querySelector<HTMLElement>(".act__live")!;
    const dead = root.querySelector<HTMLElement>(".act__nosignal")!;
    const grid = root.querySelector<HTMLElement>(".act__grid")!;
    const count = root.querySelector<HTMLElement>(".act__count")!;

    type Activity = { signal: boolean; total?: number; levels?: number[] };
    const noSignal = () => { live.hidden = true; dead.hidden = false; };

    // ?nosignal=1 keeps the designed failure state reachable for testing once
    // the prototype's demo toggle is gone. plan.md §9
    if (new URLSearchParams(location.search).has("nosignal")) {
      noSignal();
    } else {
      fetch("/api/activity")
        .then((r) => r.json() as Promise<Activity>)
        .then((d) => {
          if (!d?.signal || !Array.isArray(d.levels)) return noSignal();
          const cells = grid.querySelectorAll<HTMLElement>(".cell");
          d.levels.slice(-cells.length).forEach((lvl, i) => {
            cells[i].dataset.lvl = String(lvl);
          });
          grid.setAttribute(
            "aria-label",
            `Contribution heatmap: ${d.total} contributions over the last 52 weeks.`,
          );
          count.textContent = `${d.total} CONTRIBUTIONS`;
        })
        .catch(noSignal);
    }
  }
</script>

<style>
  .meta-cells {
    display: flex;
    border: var(--hairline) solid var(--rule);
    background: var(--paper-2);
    margin-bottom: 10px;
  }
  .meta-cells__cell { padding: 9px 14px; border-right: var(--hairline) solid var(--rule); }
  .meta-cells__cell:last-child { border-right: 0; }
  .lbl { display: block; font-size: var(--fs-label); color: var(--graphite); }
  .val { display: block; font-size: var(--fs-prose); margin-top: 4px; }

  .act { border-top: var(--hairline) solid var(--rule); padding: 32px var(--pad-x); }
  .act__chart { display: flex; gap: 12px; align-items: flex-start; }
  .act__days {
    display: grid;
    grid-template-rows: repeat(7, 13px);
    gap: 3px;
    font-size: var(--fs-label);
    color: var(--graphite);
    padding-top: 1px;
  }
  /* Scrolls inside its own container. The grid has a ~829px floor, and it must
     never widen the page. plan.md §11.1 */
  .act__scroll { flex: 1; overflow-x: auto; min-width: 0; }
  .act__grid {
    display: grid;
    grid-template-rows: repeat(7, 13px);
    grid-auto-flow: column;
    grid-auto-columns: 13px;
    gap: 3px;
  }
  .cell { width: 13px; height: 13px; border: var(--hairline) solid var(--rule); display: block; }
  .cell[data-lvl="0"] { background: var(--heat-0); }
  .cell[data-lvl="1"] { background: var(--heat-1); }
  .cell[data-lvl="2"] { background: var(--heat-2); }
  .cell[data-lvl="3"] { background: var(--heat-3); }
  .cell[data-lvl="4"] { background: var(--heat-4); }

  .act__months {
    display: flex;
    justify-content: space-between;
    margin-top: 10px;
    font-size: var(--fs-label);
    color: var(--graphite);
    max-width: 848px;
  }

  .act__foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    margin-top: 26px;
    padding-top: 18px;
    border-top: var(--hairline) solid var(--rule);
  }
  .act__count { font-size: var(--fs-meta); color: var(--graphite); }
  .act__legend { display: flex; align-items: center; gap: 8px; font-size: var(--fs-label); color: var(--graphite); }

  .act__nosignal {
    border: var(--hairline) solid var(--rule);
    background: var(--paper-2);
    padding: 56px var(--pad-x);
    text-align: center;
  }
  .act__state { font-size: 12px; letter-spacing: var(--ls-label); }
  .act__note { margin: 12px auto 0; max-width: 50ch; font-size: var(--fs-prose); color: var(--graphite); }

  @media (max-width: 768px) {
    .act__foot { flex-direction: column; align-items: flex-start; gap: 14px; }
  }
</style>
