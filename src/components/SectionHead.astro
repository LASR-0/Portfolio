---
/* Section heading band. The numbered marker replaces a tracked-out eyebrow —
   plan.md §3. Numbering is only applied where content is genuinely sequential,
   so `num` is optional: Work / Experience / Activity carry 01-03, Gallery,
   Hobbies and Start a project do not. */

interface Props {
  num?: string;
  title: string;
  id?: string;
}

const { num, title, id } = Astro.props;
---

<div class="sechead">
  <div class="sechead__lockup">
    {num && <span class="sechead__num">{num}</span>}
    <h2 id={id}>{title}</h2>
  </div>
  <slot />
</div>
