---
import type { CollectionEntry } from "astro:content";

interface Props { project: CollectionEntry<"projects">; }
const { project } = Astro.props;
const p = project.data;

/* Category tags are solid-filled with paper-2 text, the same treatment as the
   primary button. See the contrast note in tokens.css. */
const KIND_CLASS = {
  "Internal tools": "card__kind--internal",
  "Open source": "card__kind--oss",
  "Personal": "card__kind--personal",
} as const;
---

<article class="card">
  <div class="card__head">
    <span class:list={["card__kind", KIND_CLASS[p.kind]]}>{p.kind}</span>
    <span class="card__statuswrap">
      <span class:list={["card__status", p.dot && "card__status--on"]}>
        {p.dot && <span class:list={["card__dot", `card__dot--${p.dot}`]} aria-hidden="true"></span>}
        {p.status}
      </span>
      {p.note && <span class="card__note">{p.note}</span>}
    </span>
  </div>

  <div class="card__body">
    <h3 class="card__title">{p.name}</h3>
    <p class="card__blurb">{p.blurb}</p>
  </div>

  <div class="card__cells">
    <div class="card__cell"><span class="lbl">STACK</span><span class="val">{p.stack}</span></div>
    <div class="card__cell"><span class="lbl">ROLE</span><span class="val">{p.role}</span></div>
  </div>

  <div class="card__cells card__cells--foot">
    <div class="card__cell"><span class="lbl">YEAR</span><span class="val">{p.year}</span></div>
    <div class="card__cell"><span class="lbl">{p.metricLabel}</span><span class="val">{p.metric}</span></div>
    <a class="card__open" href={`/work/${project.id}`} aria-label={`Open case study for ${p.name}`}>→</a>
  </div>
</article>

<style>
  .card {
    border-right: var(--hairline) solid var(--rule);
    border-bottom: var(--hairline) solid var(--rule);
    background: var(--paper-2);
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .card__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    padding: 12px 16px;
    /* Reserves the two-line height whether or not this card has a note.
       Without it, a card carrying one throws the head hairline out of
       alignment with its neighbours. Same reasoning as .val below. */
    min-height: 52px;
    border-bottom: var(--hairline) solid var(--rule);
  }
  .card__kind {
    padding: 3px 8px;
    font-size: var(--fs-label);
    letter-spacing: var(--ls-label);
    color: var(--paper-2);
    white-space: nowrap;
  }
  .card__kind--internal { background: var(--tag-internal); }
  .card__kind--oss      { background: var(--tag-oss); }
  .card__kind--personal { background: var(--tag-personal); }
  /* Status stacks over its note so the head row stays one line tall when
     there is no note. */
  .card__statuswrap {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 3px;
    min-width: 0;
  }
  .card__status {
    display: flex;
    align-items: center;
    gap: 7px;
    font-size: var(--fs-label);
    line-height: 1.2;
    color: var(--graphite);
    white-space: nowrap;
  }
  .card__status--on { color: var(--ink); }
  .card__dot { width: 6px; height: 6px; display: block; }
  .card__dot--production { background: var(--status-live); }
  .card__dot--active     { background: var(--status-active); }
  /* Deliberately softened — reads as secondary to the status above it. */
  .card__note {
    font-size: 9px;
    line-height: 1.2;
    letter-spacing: var(--ls-label);
    color: var(--graphite);
    opacity: 0.7;
    white-space: nowrap;
  }

  .card__body { padding: 26px 16px 44px; min-height: 150px; }
  .card__title {
    font-weight: 600;
    font-size: var(--fs-card);
    line-height: var(--lh-card);
    /* 34px display type in a ~360px column: break rather than overflow. */
    overflow-wrap: anywhere;
  }
  .card__blurb {
    margin: 14px 0 0;
    font-size: var(--fs-prose);
    color: var(--graphite);
    text-wrap: pretty;
  }

  .card__cells {
    margin-top: auto;
    display: grid;
    grid-template-columns: 1fr 1fr;
    border-top: var(--hairline) solid var(--rule);
  }
  .card__cells--foot { margin-top: 0; grid-template-columns: 1fr 1fr 62px; }
  .card__cell {
    padding: 11px 16px;
    border-right: var(--hairline) solid var(--rule);
    min-width: 0;
  }
  .card__cells--foot .card__cell:nth-child(2) { border-right: var(--hairline) solid var(--rule); }
  .card__cell:last-child { border-right: 0; }

  .lbl {
    display: block;
    font-size: var(--fs-label);
    color: var(--graphite);
    letter-spacing: var(--ls-label);
  }
  /* At 4 columns these cells are ~148px, so longer stack strings wrap. The
     value reserves two lines whether it needs them or not, otherwise the
     horizontal hairlines stop aligning across the row — which on a drafting
     sheet reads as broken. plan.md §10.1 */
  .val {
    display: block;
    font-size: 14px;
    margin-top: 5px;
    line-height: 1.25;
    min-height: 2.5em;
    overflow-wrap: anywhere;
  }

  .card__open {
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 16px;
    border-left: var(--hairline) solid var(--rule);
  }
  .card__open:hover { background: var(--ink); color: var(--paper-2); }
</style>
