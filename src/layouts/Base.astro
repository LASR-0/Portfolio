---
import "../styles/global.css";

/* Metadata — plan.md §11.4.
   For audience 1 (someone opening a link from a job application) the OG card
   is the first impression, before the site even loads: it is what renders in
   Slack, LinkedIn, iMessage and Gmail previews.

   Every absolute URL here resolves against `site` in astro.config.mjs. */

interface Props {
  title: string;
  description?: string;
  /* Set on /work/[slug] so case studies describe themselves as articles. */
  type?: "website" | "article";
  image?: string;
}

const {
  title,
  description = "IT support and internal-tooling developer in Brisbane. Internal apps for a ~300-user org, open-source side projects, and digital painting.",
  type = "website",
  image = "/og.png",
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site);

const person = {
  "@context": "https://schema.org",
  "@type": "ProfilePage",
  mainEntity: {
    "@type": "Person",
    name: "Luke Roxburgh",
    jobTitle: "IT Support Officer",
    description,
    url: Astro.site?.href,
    address: {
      "@type": "PostalAddress",
      addressLocality: "Brisbane",
      addressRegion: "QLD",
      addressCountry: "AU",
    },
    /* TODO: add the LinkedIn URL here once it exists — sameAs is what ties
       these profiles together for search engines. */
    sameAs: ["https://github.com/LASR-0"],
  },
};
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical.href} />

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="Luke Roxburgh" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:image" content={ogImage.href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="en_AU" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage.href} />

    <meta name="theme-color" content="#EAE7DE" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title="Sitemap" href="/sitemap-index.xml" />

    <script type="application/ld+json" set:html={JSON.stringify(person)} is:inline />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <slot />
  </body>
</html>
